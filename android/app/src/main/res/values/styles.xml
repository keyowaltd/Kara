<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Kara Splash Screen Theme -->
    <style name="KaraSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kara_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/kara_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Main Kara App Theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

</resources>